//@version=6
indicator("Live Volatility Forecast", overlay=false, max_bars_back=500)

var string SERVER = "https://web-production-1251c.up.railway.app"
string ticker   = input.symbol("SPY", title="Ticker")
string interval = input.string("5m",  title="Interval", options=["1m","5m","15m","1h"])

string url = SERVER + "/api/pine?ticker=" + ticker + "&interval=" + interval
map<string, float> json = request.json(url, ignore_invalid_symbol=true)

float low_t  = map.get(json, "low_thresh")
float med_t  = map.get(json, "medium_thresh")
float high_t = map.get(json, "high_thresh")
float dir_up = map.get(json, "direction_up")
float conf   = map.get(json, "confidence")

float f1 = map.get(json, "f1")
float f2 = map.get(json, "f2")
float f3 = map.get(json, "f3")
float f4 = map.get(json, "f4")
float f5 = map.get(json, "f5")
float f6 = map.get(json, "f6")

float f1l = map.get(json, "f1_low")
float f2l = map.get(json, "f2_low")
float f3l = map.get(json, "f3_low")
float f4l = map.get(json, "f4_low")
float f5l = map.get(json, "f5_low")
float f6l = map.get(json, "f6_low")

float f1h = map.get(json, "f1_hi")
float f2h = map.get(json, "f2_hi")
float f3h = map.get(json, "f3_hi")
float f4h = map.get(json, "f4_hi")
float f5h = map.get(json, "f5_hi")
float f6h = map.get(json, "f6_hi")

getColor(float v, float t) =>
    v < low_t ? color.new(color.green, t) : v < med_t ? color.new(color.yellow, t) : v < high_t ? color.new(color.orange, t) : color.new(color.red, t)

hline(low_t,  "Low",    color=color.new(color.green,  40), linestyle=hline.style_dashed)
hline(med_t,  "Medium", color=color.new(color.yellow, 40), linestyle=hline.style_dashed)
hline(high_t, "High",   color=color.new(color.orange, 40), linestyle=hline.style_dashed)

bgcolor(na(f1) ? na : getColor(f1, 92), title="Regime")

if barstate.islast and not na(f1)
    string arrow = dir_up == 1 ? "▲ UP" : "▼ DOWN"
    color  dcol  = dir_up == 1 ? color.new(color.green, 20) : color.new(color.red, 20)
    label.new(bar_index, high_t * 1.15, arrow + "  " + str.tostring(math.round(conf * 100)) + "%", style=label.style_label_down, size=size.normal, color=dcol, textcolor=color.white)

    float pv = f1
    int   pi = bar_index

    for i = 0 to 5
        float v  = i == 0 ? f1 : i == 1 ? f2 : i == 2 ? f3 : i == 3 ? f4 : i == 4 ? f5 : f6
        float lo = i == 0 ? f1l : i == 1 ? f2l : i == 2 ? f3l : i == 3 ? f4l : i == 4 ? f5l : f6l
        float hi = i == 0 ? f1h : i == 1 ? f2h : i == 2 ? f3h : i == 3 ? f4h : i == 4 ? f5h : f6h
        int   fi = bar_index + i + 1
        color fc = getColor(v, 30.0)

        line.new(pi, pv, fi, v, color=fc, width=2, style=line.style_dotted)
        line.new(fi, lo, fi, hi, color=color.new(fc, 70), width=6, style=line.style_solid)
        label.new(fi, v, "+" + str.tostring((i + 1) * 5) + "m\n" + str.tostring(v, "#.#####"), style=label.style_label_down, size=size.tiny, color=color.new(fc, 60), textcolor=color.white)

        pv := v
        pi := fi

    label.new(bar_index, f1, "▶ live", style=label.style_label_left, size=size.small, color=color.new(color.blue, 50), textcolor=color.white)
